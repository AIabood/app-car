generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DRIVER
  ADMIN
}

enum ReportType {
  CAMERA
  ACCIDENT
  ROAD_WORK
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DrivingStatus {
  SAFE
  WARNING
  DANGER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole @default(DRIVER)
  language     String   @default("ar")
  darkMode     Boolean  @default(false) @map("dark_mode")
  alertMargin  Int      @default(5) @map("alert_margin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  trips              Trip[]
  favorites          Favorite[]
  communityReports   CommunityReport[] @relation("ReportAuthor")
  reviewedReports    CommunityReport[] @relation("ReportReviewer")
  notifications      Notification[]
  settings           UserSettings[]

  @@map("users")
}

model Trip {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  startedAt       DateTime  @map("started_at")
  endedAt         DateTime? @map("ended_at")
  distanceKm      Float?    @map("distance_km")
  durationMin     Int?      @map("duration_min")
  avgSpeed        Float?    @map("avg_speed")
  maxSpeed        Float?    @map("max_speed")
  speedViolations Int       @default(0) @map("speed_violations")
  drivingScore    Int?      @map("driving_score")
  createdAt       DateTime  @default(now()) @map("created_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  points TripPoint[]
  violations SpeedViolation[]

  @@index([userId])
  @@map("trips")
}

/// GPS points — lat/lng now; PostGIS geometry added via SQL migration
model TripPoint {
  id        String   @id @default(uuid())
  tripId    String   @map("trip_id")
  latitude  Float
  longitude Float
  /// PostGIS point for efficient geo queries. Fill via migration then drop lat/long.
  location  Unsupported("geography(Point,4326)")?
  speed     Float?
  recordedAt DateTime @map("recorded_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_points")
}

model SpeedCamera {
  id          String   @id @default(uuid())
  name        String?
  latitude    Float
  longitude   Float
  /// PostGIS point for efficient geo queries. Fill via migration then drop lat/long.
  location    Unsupported("geography(Point,4326)")?
  cameraType  String   @default("fixed") @map("camera_type")
  speedLimit  Int?     @map("speed_limit")
  isActive    Boolean  @default(true) @map("is_active")
  source      String   @default("system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([latitude, longitude])
  @@map("speed_cameras")
}

model CommunityReport {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  reportType  ReportType   @map("report_type")
  latitude    Float
  longitude   Float
  location    Unsupported("geography(Point,4326)")?
  description String?
  status      ReportStatus @default(PENDING)
  reviewedBy  String?      @map("reviewed_by")
  reviewedAt  DateTime?    @map("reviewed_at")
  expiresAt   DateTime?    @map("expires_at")
  upVotes     Int          @default(0) @map("up_votes")
  downVotes   Int          @default(0) @map("down_votes")
  imagesCount Int          @default(0) @map("images_count")
  createdAt   DateTime     @default(now()) @map("created_at")

  user     User  @relation("ReportAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReportReviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@index([latitude, longitude])
  @@map("community_reports")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  latitude  Float
  longitude Float
  location  Unsupported("geography(Point,4326)")?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("favorites")
}

/// Generalized road devices (cameras, radars, red-light, average speed)
model RoadDevice {
  id         String  @id @default(uuid())
  deviceType String  @map("device_type")
  name       String?
  location   Unsupported("geography(Point,4326)")
  speedLimit Int?    @map("speed_limit")
  direction  String?
  isActive   Boolean @default(true) @map("is_active")
  source     String  @default("system")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("road_devices")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  body      String
  type      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model UserSettings {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  key       String
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_settings")
}

model SpeedViolation {
  id          String   @id @default(uuid())
  tripId      String   @map("trip_id")
  location    Unsupported("geography(Point,4326)")
  vehicleSpeed Float   @map("vehicle_speed")
  roadSpeed    Int     @map("road_speed")
  createdAt    DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("speed_violations")
}
